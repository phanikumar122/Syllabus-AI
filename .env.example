# Public Firebase web configuration. Complete all six to enable Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional named Firestore database; blank uses (default).
VITE_FIREBASE_DATABASE_ID=
# Same-origin API prefix. Vite proxies /api to the local backend.
VITE_AI_API_URL=/api

# Server-only settings. Never prefix provider or service-account secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_PROJECT_ID=
# Path to a service-account JSON outside this repository; or use workload credentials.
GOOGLE_APPLICATION_CREDENTIALS=
PORT=3001
# Optional localhost-only AI access without sign-in. Ignored in production.
ALLOW_LOCAL_AI=false

# Public app origin for Stripe returns and notification links. HTTPS in production.
APP_URL=http://localhost:3000
# Server-only Stripe subscriptions. Start with test-mode keys and a test recurring price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional paid gate for AI, email and push. Manual study management stays available.
BILLING_REQUIRED=false
# SMTP server with TLS (587 STARTTLS or 465 implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Generate the pair with npm run setup:services. Subject is your public contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Enable on an always-running server, or schedule notifications:once externally.
NOTIFICATION_WORKER_ENABLED=false
