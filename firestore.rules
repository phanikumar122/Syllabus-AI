rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function profile(d,uid) { return d.keys().hasOnly(['uid','email','displayName','photoURL','createdAt','updatedAt']) && d.uid == uid && d.email is string && d.email.size() <= 320 && d.displayName is string && d.displayName.size() <= 160 && d.photoURL is string && d.photoURL.size() <= 2048; }
  function syllabus(d) { return d.keys().hasOnly(['id','name','description','examDate','dailyHours','status','createdAt','updatedAt']) && d.name is string && d.name.size() > 0 && d.name.size() <= 160 && date(d.examDate) && d.dailyHours is number && d.dailyHours >= 0.5 && d.dailyHours <= 12; }
  function topic(d) { return d.keys().hasOnly(['id','title','subject','difficulty','estimatedHours','order','createdAt']) && d.title is string && d.title.size()>0 && d.title.size()<=200 && d.difficulty in ['Easy','Medium','Hard'] && d.estimatedHours is number && d.estimatedHours >= 0.166666 && d.estimatedHours <= 24; }
  function plan(d) { return d.keys().hasOnly(['id','startDate','endDate','schedule','updatedAt']) && d.schedule is list && d.schedule.size() <= 730; }
  function progress(d) { return d.keys().hasOnly(['topicId','status','completedAt']) && d.topicId is string && d.topicId.size() <= 160 && d.status in ['Not Started','In Progress','Completed']; }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && profile(request.resource.data,uid);
   match /syllabi/{sid} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid) && syllabus(request.resource.data);
    match /topics/{tid} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && topic(request.resource.data); }
    match /plans/{pid} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && plan(request.resource.data); }
    match /progress/{pid} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && progress(request.resource.data); }
   }
   match /workspaces/{wid} {
    allow read: if owner(uid) && wid=='main';
    allow create: if owner(uid) && wid=='main' && manifest(request.resource.data) && request.resource.data.revision==1;
    allow update: if owner(uid) && wid=='main' && manifest(request.resource.data) && ((resource.data.schemaVersion==1 && request.resource.data.revision==1) || (resource.data.schemaVersion==2 && request.resource.data.revision==resource.data.revision+1));
    function manifest(d) { return d.keys().hasOnly(['schemaVersion','revision','chunkCount','updatedAt']) && d.schemaVersion==2 && d.revision is int && d.revision>0 && d.chunkCount is int && d.chunkCount>=1 && d.chunkCount<=80 && d.updatedAt==request.time; }
    match /chunks/{chunkId} {
     allow read: if owner(uid) && wid=='main';
     allow create, update: if owner(uid) && wid=='main' && chunkId.matches('^([0-9]|[1-7][0-9])$') && request.resource.data.keys().hasOnly(['payload']) && request.resource.data.payload is string && request.resource.data.payload.size()<=400000 && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/main).data.updatedAt==request.time;
     allow delete: if owner(uid) && wid=='main' && getAfter(/databases/$(database)/documents/users/$(uid)/workspaces/main).data.updatedAt==request.time;
    }
   }
  }
 }
}
