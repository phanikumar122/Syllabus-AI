{
  "name": "syllabus-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --port=3000 --host=127.0.0.1\"",
    "dev:web": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "setup:services": "node scripts/setup-services.mjs",
    "services:check": "node scripts/check-services.mjs",
    "notifications:once": "node scripts/notifications-once.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-syllabus-ai \"node --import tsx --test tests/firestore.emulator.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^14.5.1",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "minimatch": "^11.0.8",
    "glob": "^14.0.2",
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1"
  }
}
